# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.scalingo.io

# Database - Leave empty for SQLite, or set DATABASE_URL for PostgreSQL
# Example PostgreSQL: postgresql://user:password@localhost/espaces_ouverts
DATABASE_URL=postgresql://user:password@localhost/espaces_ouverts

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# AWS S3 Configuration (optional - for production)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# BAN API Configuration (optional)
BAN_API_SEARCH_URL=https://api-adresse.data.gouv.fr/search/
BAN_API_TIMEOUT_SECONDS=5
