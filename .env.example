# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.scalingo.io

# Database - Leave empty for SQLite, or set DATABASE_URL for PostgreSQL
# Example PostgreSQL: postgresql://user:password@localhost/espaces_ouverts
DATABASE_URL=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# File Storage Configuration
# For development: leave these empty to use local filesystem storage
# For production with S3: set USE_S3=True and provide AWS credentials
USE_S3=False

# AWS S3 Configuration (optional - for production file storage)
# When AWS_ACCESS_KEY_ID is set, S3 storage is automatically enabled
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=True
# Optional: custom domain for S3 CDN (e.g., cdn.example.com)
AWS_S3_CUSTOM_DOMAIN=
# Optional: custom media URL (defaults to S3 bucket URL)
MEDIA_URL=

# Scaleway Object Storage example (S3-compatible)
# AWS_S3_REGION_NAME=fr-par
# AWS_S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Geocoding Configuration (optional)
GEOCODING_TIMEOUT_SECONDS=10
